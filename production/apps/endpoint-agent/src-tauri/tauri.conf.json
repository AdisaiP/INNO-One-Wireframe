{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "INNO.One Agent",
  "version": "0.1.0",
  "identifier": "com.innovationssolutionsservice.innoone.agent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5180",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "INNO.One Agent",
        "width": 820,
        "height": 900,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": []
  }
}

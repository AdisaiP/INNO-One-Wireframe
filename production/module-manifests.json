      "route": "/helpdesk",
      "surface": "web",
      "launcher": true,
      "entryPermission": "helpdesk.ticket.view",
      "dependencies": ["platform", "devices", "assets"],
      "permissions": [
        "helpdesk.ticket.view",
        "helpdesk.ticket.create",
        "helpdesk.ticket.reply",
        "helpdesk.ticket.assign",
        "helpdesk.ticket.resolve",
        "helpdesk.sla.manage",
        "helpdesk.automation.view",
        "helpdesk.automation.manage"
      ],
      "navigation": [
        { "id": "overview", "label": "Overview", "route": "/helpdesk", "permission": "helpdesk.ticket.view" },
        { "id": "tickets", "label": "Tickets", "route": "/helpdesk/tickets", "permission": "helpdesk.ticket.view" },
        { "id": "assigned", "label": "Assigned to Me", "route": "/helpdesk/assigned", "permission": "helpdesk.ticket.view" },
        { "id": "team", "label": "Team Queue", "route": "/helpdesk/team", "permission": "helpdesk.ticket.view" },
        { "id": "sla", "label": "SLA & Escalation", "route": "/helpdesk/sla", "permission": "helpdesk.ticket.view" },
        { "id": "calendar", "label": "Business Calendar", "route": "/helpdesk/calendar", "permission": "helpdesk.sla.manage" },
        { "id": "automation", "label": "Automation", "route": "/helpdesk/automation", "permission": "helpdesk.automation.view" }
      ],
      "events": [
        "ticket.created",
        "ticket.assigned",
        "ticket.resolved"
      ],
      "capabilities": [
        "navigation",
        "global-search",
        "audit",
        "events"
      ]
    },
    {
      "id": "workflows",
      "name": "Dynamic Workflows",
      "icon": "automation",
      "route": "/workflows",
      "surface": "web",
      "launcher": true,
      "entryPermission": "workflows.view",
      "dependencies": ["platform"],
      "permissions": [
        "workflows.view",
        "workflows.manage"
      ],
      "navigation": [
        { "id": "definitions", "label": "All Workflows", "route": "/workflows", "permission": "workflows.view" },
        { "id": "new", "label": "New Workflow", "route": "/workflows/new", "permission": "workflows.manage" }
      ],
      "events": [],
      "capabilities": [
        "navigation"
      ]
    },
    {
      "id": "meeting",
      "name": "Meeting",
      "icon": "meeting",
      "route": "/meeting",
      "surface": "web",
      "launcher": true,
      "entryPermission": "meeting.view",
      "dependencies": ["platform"],
      "permissions": [
        "meeting.view",
        "meeting.create",
        "meeting.record",
        "meeting.share",

{
  "schemaVersion": 1,
  "modules": [
    {
      "id": "devices",
      "name": "Devices",
      "icon": "devices",
      "route": "/devices",
      "surface": "web",
      "launcher": true,
      "entryPermission": "devices.view",
      "dependencies": ["platform"],
      "permissions": [
        "devices.view",
        "devices.manage",
        "devices.deploy",
        "devices.remote"
      ],
      "navigation": [
        { "id": "overview", "label": "Devices", "route": "/devices", "permission": "devices.view" },
        { "id": "discovery", "label": "Discovery", "route": "/devices/discovery", "permission": "devices.view" },
        { "id": "query", "label": "Inventory Query", "route": "/devices/query", "permission": "devices.view" },
        { "id": "groups", "label": "Device Groups", "route": "/devices/groups", "permission": "devices.view" },
        { "id": "deployment", "label": "Agent Deployment", "route": "/devices/add", "permission": "devices.deploy" }
      ],
      "events": [
        "device.online",
        "device.offline",
        "remote.started"
      ],
      "capabilities": [
        "navigation",
        "global-search",
        "audit",
        "events"
      ]
    },
    {
      "id": "assets",
      "name": "Assets",
      "icon": "assets",
      "route": "/assets",
      "surface": "web",
      "launcher": true,
      "entryPermission": "assets.view",
      "dependencies": ["platform", "devices"],
      "permissions": [
        "assets.view",
        "assets.manage",
        "assets.qr.print",
        "assets.qr.scan",
        "assets.license.manage",
        "assets.contract.manage",
        "assets.baseline.manage"
      ],
      "navigation": [
        { "id": "overview", "label": "Overview", "route": "/assets", "permission": "assets.view" },
        { "id": "inventory", "label": "Asset Inventory", "route": "/assets/inventory", "permission": "assets.view" },
        { "id": "baselines", "label": "Software Baselines", "route": "/assets/software-baselines", "permission": "assets.view" },
        { "id": "licenses", "label": "Software Licenses", "route": "/assets/software-licenses", "permission": "assets.license.manage" },
        { "id": "contracts", "label": "Contracts & Warranty", "route": "/assets/contracts", "permission": "assets.view" },
        { "id": "custom-fields", "label": "Custom Fields", "route": "/assets/custom-fields", "permission": "assets.view" },
        { "id": "qr-labels", "label": "QR Labels", "route": "/assets/qr-labels", "permission": "assets.qr.print" },
        { "id": "ownership", "label": "Ownership Overview", "route": "/assets/ownership", "permission": "assets.view" },
        { "id": "owners", "label": "Asset Owners", "route": "/assets/owners", "permission": "assets.view" },
        { "id": "submissions", "label": "Agent Submissions", "route": "/assets/ownership/submissions", "permission": "assets.view" }
      ],
      "events": ["ownership.changed"],
      "capabilities": [
        "navigation",
        "global-search",
        "audit",
        "events"
      ]
    },
    {
      "id": "helpdesk",

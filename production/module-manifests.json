      "navigation": [
        { "id": "overview", "label": "Overview", "route": "/meeting", "permission": "meeting.view" }
      ],
      "events": [
        "meeting.created",
        "transcript.completed",
        "summary.completed"
      ],
      "capabilities": [
        "navigation",
        "global-search",
        "audit",
        "events"
      ]
    },
    {
      "id": "reports",
      "name": "Reports",
      "icon": "reports",
      "route": "/reports",
      "surface": "web",
      "launcher": true,
      "entryPermission": "reports.view",
      "dependencies": ["platform", "devices", "assets", "helpdesk"],
      "permissions": [
        "reports.view",
        "reports.create",
        "reports.manage"
      ],
      "navigation": [
        { "id": "overview", "label": "Overview", "route": "/reports", "permission": "reports.view" }
      ],
      "events": [],
      "capabilities": [

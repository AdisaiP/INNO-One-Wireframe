# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . ./production
RUN dotnet restore production/services/platform-api/src/INNO.One.PlatformApi/INNO.One.PlatformApi.csproj
RUN dotnet publish production/services/platform-api/src/INNO.One.PlatformApi/INNO.One.PlatformApi.csproj \
    -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:5080
EXPOSE 5080
ENTRYPOINT ["dotnet", "INNO.One.PlatformApi.dll"]

# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /src
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/web-portal ./apps/web-portal
RUN pnpm install --frozen-lockfile --filter @inno/web-portal...

ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM=inno-one
ARG VITE_KEYCLOAK_CLIENT_ID=inno-one-web
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL
ENV VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM
ENV VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN pnpm --filter @inno/contracts build \
 && pnpm --filter @inno/shared build \
 && pnpm --filter @inno/auth build \
 && pnpm --filter @inno/i18n build \
 && pnpm --filter @inno/ui build \
 && pnpm --filter @inno/web-portal build

FROM nginx:1.27-alpine AS runtime
COPY infrastructure/docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/web-portal/dist /usr/share/nginx/html
EXPOSE 80

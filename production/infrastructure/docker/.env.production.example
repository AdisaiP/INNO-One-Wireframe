# Production deployment defaults for 172.10.1.58.
# Copy to .env.production and replace every CHANGE_ME value before starting.
PUBLIC_HOST=172.10.1.58
PORTAL_PORT=8082
PORTAL_HTTPS_PORT=8446
POSTGRES_PORT=5433
KEYCLOAK_PORT=8180
MESHCENTRAL_PORT=8445

PUBLIC_PORTAL_URL=https://172.10.1.58:8446
PUBLIC_KEYCLOAK_URL=https://172.10.1.58:8446/auth
PUBLIC_MESHCENTRAL_WS_URL=wss://172.10.1.58:8445

POSTGRES_USER=inno
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK
MESHCENTRAL_USERNAME=innoapi
MESHCENTRAL_PASSWORD=CHANGE_ME_MESHCENTRAL

  "privacy": {
    "neverPersistInEventsOrAudit": [
      "password",
      "accessToken",
      "refreshToken",
      "idToken",
      "clientSecret",
      "apiKey",
      "privateKey",
      "sessionCookie",
      "authorizationHeader",
      "smtpPassword",
      "meshCentralCredential",
      "rawQrToken"
    ],
    "contentRules": [
      "ticket descriptions and reply bodies are referenced by ticket/reply ID, not copied into integration events",
      "meeting audio, transcript text and summary body are referenced by IDs, not copied into integration events or generic audit metadata",
      "remote chat message body is not copied into integration event; use messageId",
      "file contents are never embedded; use fileId and safe metadata",
      "QR scan events never persist the raw QR token; use assetId/scanId/token fingerprint if needed",
      "whole device software inventory is referenced by snapshotId, not copied into integration events or generic audit metadata"
    ],
    "piiRule": "store only identifiers and minimum context needed for business/security purpose"
  },
  "correlation": {
    "httpHeader": "X-Correlation-Id",
    "eventField": "correlationId",
    "auditField": "correlationId",
    "causation": "eventId or command/operation ID that directly triggered work",
    "trace": "propagate OpenTelemetry-compatible traceId where available"
  }
}

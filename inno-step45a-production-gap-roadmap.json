  "frozenDecisions": [
    {
      "id": "workflow-ownership",
      "decision": "Dynamic Workflow is a standalone Web application/module shared across domains.",
      "reason": "Its node model includes cross-module trigger/action/approval/assignment/notification/subflow behavior. Helpdesk Automation remains the simple Trigger -> Condition -> Action P04 editor."
    },
    {
      "id": "workflow-component",
      "decision": "Use the existing @inno/ui/workflow INNOWorkflowCanvas foundation.",
      "reason": "React Flow + ELK.js is already isolated, QA-proven and must not be duplicated."
    },
    {
      "id": "meeting-agent-dependency",
      "decision": "Meeting web workspace and Endpoint Agent recording are separate surfaces connected by API/contracts.",
      "reason": "Web owns Meeting workspace; Endpoint Agent owns local recording interaction."
    },
    {
      "id": "future-module-visibility",
      "decision": "Deferred/foundation-only modules remain absent from normal navigation until a real product route and installed module state exist.",
      "reason": "Availability contract prohibits normal navigation into placeholder-only product flows."
    },
    {
      "id": "forms-scheduling",
      "decision": "Forms remains backlog-only and is not assigned a numbered implementation step.",
      "reason": "No current approved Production scope or contract justifies implementation."
    }
  ],

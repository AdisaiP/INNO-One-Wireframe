    },
    "keycloakDatabase": {
      "name": "keycloak",
      "owner": "Keycloak",
      "rule": "INNO.One modules do not read Keycloak tables directly."
    },
    "meshCentralPersistence": {
      "owner": "MeshCentral",
      "rule": "INNO.One never queries vendor persistence directly; Devices adapter uses vendor API/protocol."
    },
    "objectStorage": {
      "usage": [
        "helpdesk attachments",
        "meeting recordings/audio/files",
        "report exports"
      ],
      "rule": "Database stores metadata/object key only; binaries are not stored in core relational tables."
    }
  },

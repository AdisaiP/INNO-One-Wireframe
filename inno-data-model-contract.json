  "infrastructureTables": {
    "coreOutbox": "inno_core.integration.outbox_messages",
    "coreInbox": "inno_core.integration.inbox_messages",
    "coreOperations": "inno_core.integration.operations",
    "coreAudit": "inno_core.audit.audit_records",
    "meetingOutbox": "inno_meeting.integration.outbox_messages",
    "meetingInbox": "inno_meeting.integration.inbox_messages",
    "meetingAuditRule": "Meeting persists an auditable local fact/outbox in its own transaction; central audit projection consumes the durable event. No cross-database transaction."
  },
  "jsonbPolicy": {
    "allowed": [
      "small extensible metadata",
      "event outbox payload envelope",
      "audit safe metadata/change details",
      "report definition filters/grouping",
      "automation rule conditions/actions",
      "vendor-normalized extension attributes"
    ],
    "forbidden": [
      "canonical relationships that should be foreign keys within a module",
      "whole user/device/asset/ticket snapshots",
      "secrets/tokens/passwords",
      "large binary/file/audio content"
    ],
    "indexRule": "Create GIN/index only for fields proven by query workload; do not index arbitrary JSONB by default."
  },
  "deletion": {
    "default": "No universal soft-delete column.",
    "masterData": "use status/archived_at when lifecycle requires historical identity",
    "operationalResources": "use domain status plus archived_at where required",
    "immutableHistory": "never update/delete through normal CRUD; retention policy owns archival/purge",
    "readModels": "rebuildable and may be truncated/rebuilt",
    "hardDelete": "allowed only for transient/retention-managed data after policy expiry",
    "referentialRule": "do not cascade-delete cross-module references"
  },
  "time": {
    "databaseType": "timestamptz",
    "storage": "UTC",
    "createdUpdated": "created_at + updated_at on mutable entities",
    "history": "occurred_at/effective_at fields where semantically meaningful"
  },
  "naming": {
    "schemas": "snake_case singular domain names",
    "tables": "snake_case plural nouns",
    "columns": "snake_case",
    "primaryKey": "id unless contract-specific append/history key",
    "foreignKey": "<resource>_id",
    "indexes": "ix_<table>__<columns>",
    "uniqueIndexes": "ux_<table>__<columns>"
  },
  "migration": {
    "platform": "PlatformDbContext / platform schema migrations",
    "devices": "DevicesDbContext / devices schema migrations",
    "assets": "AssetsDbContext / assets schema migrations",
    "helpdesk": "HelpdeskDbContext / helpdesk schema migrations",
    "reports": "ReportsDbContext / reports schema migrations",
    "infrastructure": "InfrastructureDbContext / integration+audit+readmodel migrations",
    "meeting": "Meeting service owns inno_meeting migrations",
    "rule": "A module migration may not alter another module's tables.",
    "deployment": "apply compatible expand/backfill/contract migration sequence; never rely on manual production edits"
  },
  "multiTenancy": {
    "v1": "single deployment/security boundary; Organization Unit is not a SaaS tenant",
    "tenantIdColumn": "not introduced until an explicit multi-tenant requirement/contract exists"
  },
  "security": {
    "transport": "TLS",
    "atRest": "infrastructure-managed database/storage encryption",
    "secrets": "external secret manager/environment integration; never business tables",
    "pii": "least-privilege API access and audit; column encryption only when a concrete requirement demands it",
    "rowLevelSecurity": "not the primary v1 authorization layer; server-side permission/scope evaluation remains authoritative"
  },
  "indexing": {
    "globalRules": [
      "index all foreign keys used in joins within a module",
      "index stable cross-module reference IDs used by scope/filter queries",
      "index queue/list sort/filter columns together based on actual access patterns",
      "use partial indexes for active/open rows when query profile benefits",
      "time-series/history indexes put subject/resource ID with occurred_at where needed"
    ],
    "critical": [
      "platform.user_profiles(keycloak_subject) unique",
      "platform.organization_units(parent_unit_id, status)",
      "devices.devices(connectivity_state, organization_unit_id, last_seen_at)",
      "devices.device_external_mappings(provider, external_id) unique",
      "devices.device_group_members(group_id, device_id) unique",
      "devices.device_alerts(status, severity, detected_at desc)",
      "helpdesk.tickets(status_id, priority, created_at desc)",
      "helpdesk.tickets(assignee_user_id, status_id, updated_at desc)",
      "assets.assets(asset_tag) unique",
      "assets.assets(owner_user_id, lifecycle_status)",
      "integration.outbox_messages(status, next_attempt_at, occurred_at)",
      "integration.inbox_messages(consumer, event_id) unique",
      "audit.audit_records(occurred_at desc)",
      "audit.audit_records(actor_type, actor_id, occurred_at desc)",
      "audit.audit_records(target_type, target_id, occurred_at desc)"
    ]
  }
}

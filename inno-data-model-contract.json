  },
  "concurrency": {
    "mutableEntities": "explicit bigint version column",
    "apiETag": "serialize version as ETag",
    "updateRule": "WHERE id = @id AND version = @expectedVersion; increment on success",
    "staleResult": "HTTP 412 PRECONDITION_FAILED"
  },
  "ownershipRules": {
    "sameModuleForeignKeys": "enforced by database FK where relationship is aggregate-safe",
    "crossModuleForeignKeys": "forbidden",
    "crossModuleReference": "store stable opaque ID only; validate through owning module contract/read model",
